PORT=3000

# --- Existing app (timesheet / mandays) ---
# Link CSV publik Google Sheet (sumber sync ke Supabase tasks)
GOOGLE_SHEET_CSV_URL=
# Prefix link tiket di UI web, bukan untuk API
JIRA_BASE_URL=
GEMINI_API_KEY=
XENDIT_SECRET_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Gmail App Password — pakai tanda kutip jika ada spasi: SMTP_PASS="abcd efgh ijkl mnop"
SMTP_PASS=
SUPABASE_URL=
SUPABASE_KEY=
# Opsional: service_role bypass RLS untuk bot_tasks (Supabase → Settings → API)
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# JIRA API — bot Telegram create & ubah status task board BATB
# Dokumentasi: docs/SETUP_JIRA_TELEGRAM.md
# =============================================================================

# URL Jira Cloud (tanpa trailing slash)
JIRA_SITE=
# Email akun Atlassian pemilik API token
JIRA_EMAIL=
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Project key = Space di form Create Task (BATB)
JIRA_PROJECT_KEY=BATB
# Issue type = Work type di form (biasanya Task)
JIRA_ISSUE_TYPE=Task

# --- JIRA_CF_* = ID custom field di Jira (customfield_xxxxx) ---
# Bukan label form. Dipakai saat body JSON create issue.
# Isi otomatis: npm run jira:discover

# "Task Business Analyst" — dropdown kategori task BA
JIRA_CF_TASK_BA=
# "Start Date (BATB)" — tanggal mulai kerja task
JIRA_CF_START_DATE=
# "Duration (Minutes)" — lama task (menit); untuk timer auto Done
JIRA_CF_DURATION=
# "Team" — field tim (opsional)
JIRA_CF_TEAM=

# --- JIRA_TRANSITION_* = ID transisi workflow (angka) ---
# Untuk ubah status via API, bukan nama "Backlog"/"Done".
# Cek per project: npm run jira:discover -- BATB-12345

# Backlog → In Progress
JIRA_TRANSITION_TO_IN_PROGRESS=71
# In Progress → Done
JIRA_TRANSITION_TO_DONE=111
# → Cancel
JIRA_TRANSITION_TO_CANCEL=121

# =============================================================================
# TELEGRAM BOT
# =============================================================================

# Token dari @BotFather
TELEGRAM_BOT_TOKEN=
# polling = development | webhook = production (butuh TELEGRAM_WEBHOOK_*)
TELEGRAM_MODE=polling
# Harus HTTPS backend Vercel, path: /api/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Setelah deploy: GET /api/telegram/status lalu POST /api/telegram/set-webhook
# Whitelist user ID Telegram (pisah koma). Kosong = tidak dibatasi.
ALLOWED_TELEGRAM_IDS=
# Batas tanggal Start Date ke masa lalu (hari)
TASK_MAX_BACKDATE_DAYS=90
